# Copia este archivo como .env y reemplaza los valores. El .env nunca va al repositorio.

# --- Aplicación ---
ENTORNO=desarrollo
# Usuario de mínimo privilegio (sin DROP)
DATABASE_URL=mysql+pymysql://aquasense_app:CAMBIAR@localhost:3306/aquasense
# Usuario con permisos de esquema; solo lo usa Alembic
MIGRACIONES_DATABASE_URL=mysql+pymysql://aquasense_migraciones:CAMBIAR@localhost:3306/aquasense
# 64 caracteres aleatorios: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
HOSTS_PERMITIDOS=localhost,127.0.0.1
DISPOSITIVO_SOLO_LAN=true
DOCS_PUBLICAS=false
SESION_HORAS=8
ZONA_HORARIA_WEB=America/Mexico_City
POLLING_PANEL_S=10
POLLING_GRAFICAS_S=60

# --- Contenedor de MySQL (docker-compose.yml) ---
# Las contraseñas de estos usuarios deben coincidir con las de las URL de arriba.
# Se aplican solo la primera vez que se crea el volumen de datos.
MYSQL_ROOT_PASSWORD=CAMBIAR
MYSQL_APP_PASSWORD=CAMBIAR
MYSQL_MIGRACIONES_PASSWORD=CAMBIAR

# --- Pruebas de integración ---
# Su base debe terminar en _test: las pruebas borran y recrean las tablas.
TEST_DATABASE_URL=mysql+pymysql://aquasense_migraciones:CAMBIAR@localhost:3306/aquasense_test
